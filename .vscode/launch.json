{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RK01 Board: step debug",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/armv7m/stm32f401re/vscode-debug/rk01_demo-tiny/rk01_demo.elf",
      "configFiles": [
        "${workspaceFolder}/.vscode/openocd-stm32f401re-stlink.cfg"
      ],
      "device": "STM32F401RE",
      "interface": "swd",
      "gdbPath": "arm-none-eabi-gdb",
      "objdumpPath": "arm-none-eabi-objdump",
      "preLaunchTask": "RK01: build board debug",
      "runToEntryPoint": "main"
    }
  ]
}

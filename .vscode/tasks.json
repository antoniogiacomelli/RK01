{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RK01: build board debug",
      "type": "shell",
      "command": "make",
      "args": [
        "-j4",
        "ARCH=armv7m",
        "PLATFORM=stm32f401re",
        "APP_EXAMPLE=tiny",
        "BUILD=vscode-debug",
        "OPT=-Og",
        "FPU=OFF"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "RK01: flash board debug",
      "type": "shell",
      "command": "make",
      "args": [
        "ARCH=armv7m",
        "PLATFORM=stm32f401re",
        "APP_EXAMPLE=tiny",
        "BUILD=vscode-debug",
        "OPT=-Og",
        "FPU=OFF",
        "FLASH_TOOL=openocd",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "RK01: build board debug"
      ],
      "problemMatcher": "$gcc"
    }
  ]
}

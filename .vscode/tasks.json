{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RK01: generate compile_commands",
      "type": "shell",
      "command": "make",
      "args": [
        "ARCH=armv7m",
        "PLATFORM=stm32f401re",
        "APP_EXAMPLE=${input:appExample}",
        "compile_commands"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "RK01: build board debug",
      "type": "shell",
      "command": "make",
      "args": [
        "-j4",
        "ARCH=armv7m",
        "PLATFORM=stm32f401re",
        "APP_EXAMPLE=${input:appExample}",
        "BUILD=vscode-debug",
        "OPT=-Og",
        "FPU=OFF"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "RK01: flash board debug",
      "type": "shell",
      "command": "make",
      "args": [
        "ARCH=armv7m",
        "PLATFORM=stm32f401re",
        "APP_EXAMPLE=${input:appExample}",
        "BUILD=vscode-debug",
        "OPT=-Og",
        "FPU=OFF",
        "FLASH_TOOL=openocd",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "RK01: build board debug"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "RK01: build profile-preempt per-task-domain debug",
      "type": "shell",
      "command": "make",
      "args": [
        "-j4",
        "ARCH=armv7m",
        "PLATFORM=stm32f401re",
        "APP_EXAMPLE=05-profile-preempt",
        "EXTRA_DEFS=-DNDEBUG -DRK_CONF_SYSTICK_DIV=1000 -DPROFILE_PREEMPT_CLASS=PROFILE_PREEMPT_CLASS_PER_TASK_DOMAIN",
        "BUILD=vscode-debug",
        "OPT=-Og",
        "FPU=OFF"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc"
    }
  ],
  "inputs": [
    {
      "id": "appExample",
      "type": "promptString",
      "description": "RK01 APP_EXAMPLE to build/debug",
      "default": "tiny"
    }
  ]
}

' Common object header ownership and scope
RK_KOBJ --> RK_OBJ_SCOPE : scope
RK_KOBJ --> RK_MODULE : ownerModulePtr
RK_OBJ_ATTR --> RK_OBJ_SCOPE
RK_OBJ_ATTR --> RK_MODULE : modulePtr
RK_TASK_MEMORY --> RK_MODULE : modulePtr

' Embedded header pattern for kernel objects
RK_KOBJ <|-- RK_SHARED_MEM : RK_KOBJ_HEADER
RK_KOBJ <|-- RK_MEM_PARTITION : RK_OBJ_HEADER
RK_KOBJ <|-- RK_TIMER : RK_OBJ_HEADER
RK_KOBJ <|-- RK_SEMAPHORE : RK_OBJ_HEADER
RK_KOBJ <|-- RK_MUTEX : RK_OBJ_HEADER
RK_KOBJ <|-- RK_SLEEP_QUEUE : RK_OBJ_HEADER
RK_KOBJ <|-- RK_MESG_QUEUE : RK_OBJ_HEADER
RK_KOBJ <|-- RK_MRM : RK_OBJ_HEADER

' Core composition and pointer relationships
RK_LIST *-- RK_LIST_NODE : listDummy
RK_TIMEOUT_NODE --> RK_LIST : waitingQueuePtr
RK_SHARED_MEM *-- RK_SHARED_REGION : region
RK_SHARED_MEM --> "0..RK_NTHREADS" RK_MODULE : attachedModulePtr
RK_MODULE --> "0..RK_CONF_MODULE_SHARED_REGIONS" RK_SHARED_REGION : sharedRegionPtr
RK_MODULE "1" o-- "0..*" RK_TCB : module members
RK_TCB --> RK_MODULE : modulePtr
RK_TCB *-- RK_MODULE : privateModule
RK_TCB *-- "RK_MPU_N_REGIONS" RK_MPU_REGION : mpuRegion
RK_TCB --> RK_EXCEPTION_FRAME : syscallFramePtr
RK_TCB *-- RK_TIMEOUT_NODE : timeoutNode
RK_TCB *-- RK_LIST_NODE : tcbNode
RK_TCB o-- RK_LIST : message/wait lists
RK_TCB --> RK_MUTEX : waitingForMutexPtr
RK_MEM_PARTITION *-- RK_LIST : waitingQueue
RK_TIMER *-- RK_TIMEOUT_NODE : timeoutNode
RK_SEMAPHORE *-- RK_LIST : waitingQueue
RK_MUTEX *-- RK_LIST : waitingQueue
RK_MUTEX --> RK_TCB : ownerPtr
RK_MUTEX *-- RK_LIST_NODE : mutexNode
RK_SLEEP_QUEUE *-- RK_LIST : waitingQueue
RK_MESG_QUEUE *-- RK_LIST : waitingReceivers
RK_MESG_QUEUE *-- RK_LIST : waitingSenders
RK_MESG_QUEUE *-- RK_RING_BUFFER : ringBuf
RK_MESG *-- RK_LIST_NODE : mesgNode
RK_MESG *-- RK_LIST_NODE : ownerNode
RK_MESG --> RK_MEM_PARTITION : poolPtr
RK_MESG --> RK_TASK_HANDLE : sender/receiver
RK_MESG --> RK_TCB : ownerPtr
RK_MESG --> RK_MESG_STATE : state
RK_MRM *-- RK_MEM_PARTITION : mrmMem
RK_MRM *-- RK_MEM_PARTITION : mrmDataMem
RK_MRM --> RK_MRM_BUF : currBufPtr
RK_SYNCH_ATTR ..> RK_SYNCH_CALL_DATA : accepted into
RK_TCB --> RK_SYNCH_CALL_STATE : synchMesgCallState

' MPU, syscall, handles, and API dependencies
RK_MPU_SERVICE ..> RK_TCB
RK_MPU_SERVICE ..> RK_TASK_MEMORY
RK_MPU_SERVICE ..> RK_SHARED_REGION
RK_MPU_SERVICE ..> RK_EXCEPTION_FRAME
RK_MPU_SERVICE ..> RK_MPU_FAULT_INFO
RK_SYSCALL_DISPATCH ..> RK_EXCEPTION_FRAME
RK_SYSCALL_DISPATCH ..> RK_TCB
RK_SYSCALL_DISPATCH ..> RK_MPU_SERVICE : validates user pointers
RK_SYSCALL_DISPATCH ..> RK_CONSOLE_SERVICE : console write SVC
RK_TASK_INIT_SYSCALL_ARGS --> RK_TASK_HANDLE
RK_TASK_INIT_SYSCALL_ARGS --> RK_MODULE
RK_TASK_PROTECTED_INIT_SYSCALL_ARGS --> RK_TCB
RK_TASK_PROTECTED_INIT_SYSCALL_ARGS --> RK_TASK_MEMORY
RK_TIMER_CREATE_SYSCALL_ARGS --> RK_HANDLE : timerHandlePtr
RK_MRM_CREATE_SYSCALL_ARGS --> RK_HANDLE : mrmHandlePtr
RK_MRM_CREATE_SYSCALL_ARGS --> RK_MRM_BUF
RK_MESG_POOL_INIT_SYSCALL_ARGS --> RK_MEM_PARTITION
RK_MESG_RECV_COPY_SYSCALL_ARGS --> RK_TASK_HANDLE

KAPI_APP ..> RK_SYSCALL_DISPATCH : SVC when unprivileged
KAPI_APP ..> RK_HANDLE : object handles
KAPI_APP ..> RK_TASK_HANDLE : task handles
KAPI_MODULE ..> RK_MODULE
KAPI_MODULE ..> RK_SHARED_MEM
KAPI_MODULE ..> RK_TASK_MEMORY
KAPI_TRUSTED ..> RK_TCB
KAPI_TRUSTED ..> RK_SHARED_REGION
KAPI_TRUSTED ..> RK_TRACE_SERVICE
RK_DYN_OBJ_REGISTRY ..> RK_HANDLE : publishes/resolves
RK_DYN_OBJ_REGISTRY ..> RK_MEM_PARTITION : per-family pools
RK_DYN_OBJ_REGISTRY ..> RK_KOBJ : object header validation

' Trace and monitor snapshots
RK_TRACE_TASK_INFO --> RK_TASK_HANDLE
RK_TRACE_OBJECT_INFO ..> RK_KOBJ : snapshots
RK_TRACE_SYNC_INFO ..> RK_SEMAPHORE
RK_TRACE_SYNC_INFO ..> RK_MUTEX
RK_TRACE_TIMER_INFO ..> RK_TIMER
RK_TRACE_OVERFLOW_INFO *-- RK_TRACE_RECORD_INFO : objectRecord
RK_TRACE_SERVICE ..> RK_TRACE_TASK_INFO
RK_TRACE_SERVICE ..> RK_TRACE_OBJECT_INFO
RK_TRACE_SERVICE ..> RK_TRACE_SYNC_INFO
RK_TRACE_SERVICE ..> RK_TRACE_TIMER_INFO
RK_SYSMON_SERVICE ..> RK_KOBJ : registers names
RK_SYSMON_SERVICE ..> RK_CONSOLE_SERVICE : claims RX when idle
RK_CONSOLE_SERVICE ..> RK_SYNCH_ATTR : TX call/reply
RK_CONSOLE_SERVICE ..> RK_SYNCH_CALL_DATA : accepts caller
RK_CONSOLE_SERVICE ..> RK_CONSOLE_REQUEST : command/data
RK_CONSOLE_SERVICE ..> RK_CONSOLE_REPLY : reply status

' RKFS service task and LittleFS backing memory
RKFS_REQUEST --> RKFS_COMMAND : command
RKFS_REPLY --> RKFS_STATUS : status
RKFS_RAM *-- lfs_t
RKFS_RAM *-- lfs_config
RKFS_CLIENT ..> RKFS_REQUEST : sends copied call/reply
RKFS_CLIENT ..> RKFS_REPLY : receives reply
RKFS_CLIENT ..> RK_TASK_HANDLE : serverHandle
RKFS_SERVER_TASK ..> RKFS_REQUEST
RKFS_SERVER_TASK ..> RKFS_REPLY
RKFS_SERVER_TASK *-- RKFS_RAM : module RAM
RKFS_SERVER_TASK ..> KAPI_APP : synch message APIs

' Default application data flow
RecordRequest *-- RECORD
RecordReply *-- RECORD
RecordSlot *-- RECORD
RecordState *-- "RECORD_SLOT_COUNT" RecordSlot
RK_CONSOLE_SERVICE --> AppLineRing : owner callback writes bytes
EchoTask --> AppLineRing : reads lines
EchoTask ..> RK_CONSOLE_SERVICE : SVC + sync write
EchoTask ..> RecordRequest : builds
EchoTask ..> RecordReply : reads
EchoTask ..> RecordTask : kSynchMesgCall()
RecordTask *-- RecordState : owns
RecordTask ..> RecordRequest : accepts
RecordTask ..> RecordReply : replies
RecordTask ..> RKFS_CLIENT : persists on F401RE
EchoTask ..> KAPI_MODULE : module task
RecordTask ..> KAPI_MODULE : module task
RK_CONSOLE_SERVICE ..> KAPI_APP : callback post path

note top of RK_MPU_REGION
  ARMv7-M stores rbar + rasr.
  ARMv8-M stores rbar + rlar.
end note

note bottom of RK_HANDLE
  Encoded as tag/type/generation/slot.
  Create APIs publish handles through
  the fixed dynamic object registry.
end note

note bottom of RK_TCB
  TCB owns scheduler state, MPU region table,
  syscall restart state, event flags, IPC wait lists,
  timeout node, and optional mutex ownership state.
end note

note right of RK_MODULE
  A module is the RK01 task RAM protection domain.
  Tasks in the same module share module RAM; cross-module
  sharing requires global shared RAM or RK_SHARED_MEM.
end note

@enduml

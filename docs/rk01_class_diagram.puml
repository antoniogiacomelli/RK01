package "Public type aliases\ncore/inc/kcommondefs.h" as CommonDefs {
    enum RK_OBJ_SCOPE {
        RK_SCOPE_UNASSIGNED
        RK_SCOPE_MODULE_LOCAL
        RK_SCOPE_KERNEL_GLOBAL
    }

    enum RK_MESG_STATE {
        RK_MESG_STATE_FREE
        RK_MESG_STATE_ALLOCATED
        RK_MESG_STATE_QUEUED
        RK_MESG_STATE_RECEIVED
    }

    enum RK_SYNCH_CALL_STATE {
        RK_SYNCH_CALL_IDLE
        RK_SYNCH_CALL_QUEUED
        RK_SYNCH_CALL_ACTIVE
        RK_SYNCH_CALL_ABANDONED
    }

    class RK_HANDLE <<opaque-token>> {
        +tag : 0xA
        +kind : object family
        +generation : USHORT
        +slot : BYTE
    }

    class RK_TASK_HANDLE <<opaque-token>>
    class RK_OBJ_ATTR <<struct>> {
        +scope : RK_OBJ_SCOPE
        +modulePtr : RK_MODULE*
    }

    class RK_TASK_MEMORY <<struct>> {
        +regionBasePtr : BYTE*
        +regionBytes : ULONG
        +stackBasePtr : RK_STACK*
        +stackWords : ULONG
        +modulePtr : RK_MODULE*
    }
}

